# Copy to .env.local and fill in. Also set these in your host's build settings.
# EmailJS (contact form) — https://dashboard.emailjs.com
NEXT_PUBLIC_EMAILJS_SERVICE_ID=      # Email Services → service ID (service_…)
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=     # Email Templates → template ID (template_…)
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=      # Account → General → Public Key
